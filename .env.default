DB_NAME=svele
DB_USERNAME=svele
DB_PASSWORD=svele
DB_URI=postgresql://svele:svele@db:5432/svele
LOG_LEVEL=info

# Symmetric key used to encrypt password hashes at rest (the "pepper").
# Development value only - generate a fresh one for anything real.
PASSWORD_ENCRYPTION_KEY=svele-dev-pepper-change-me

# --- Production only (docker-compose.prod.yml / Dokploy) -------------------------------
# The public URL, scheme included. adapter-node derives the request origin from it; without
# it every form action fails its CSRF check with a bare 403.
# ORIGIN=https://svele.example.com
# PORT=3000
#
# Created only on a database that has no such user. Never resets an existing password.
# ADMIN_USERNAME=drift
# ADMIN_EMAIL=drift@example.com
# ADMIN_PASSWORD=
