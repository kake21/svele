// Mirrors projectNext's src/prisma/schema/omegaquote.prisma, minus the userPoster relation.
// There is no auth in svele yet, so quotes have no poster. When Auth.js lands, add:
//   userPoster   User @relation(fields: [userPosterId], references: [id])
//   userPosterId Int
model OmegaQuote {
  id        Int      @id @default(autoincrement())
  author    String
  quote     String
  timestamp DateTime @default(now())
}
