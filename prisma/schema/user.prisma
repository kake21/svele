// Trimmed from projectNext's src/prisma/schema/user.prisma.
//
// Dropped, because each pulls in a domain svele has not ported: the ledger account, the Stripe
// customer, dots, lockers, cabin bookings, admissions, applications, flairs, notification
// subscriptions, mailing lists, the student card and its registration queue, the profile image,
// and the Feide account. What is left is the identity, the profile fields a user page renders,
// and the two relations that carry authorisation.
enum SEX {
  FEMALE
  MALE
  OTHER
}

enum RelationshipStatus {
  NOT_SPECIFIED
  SINGLE
  TAKEN
  ITS_COMPLICATED
}

model User {
  id                     Int                @id @default(autoincrement())
  username               String             @unique
  email                  String             @unique
  firstname              String             @default("[Fjernet]")
  lastname               String             @default("[Fjernet]")
  bio                    String             @default("")
  relationshipStatus     RelationshipStatus @default(NOT_SPECIFIED)
  relationshipStatusText String             @default("")
  archived               Boolean            @default(false)
  acceptedTerms          DateTime?
  sex                    SEX?
  allergies              String?
  mobile                 String?
  emailVerified          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials Credentials?
  sessions    AuthSession[]
  memberships Membership[]

  omegaQuotes        OmegaQuote[]
  eventRegistrations EventRegistration[]
  createdEvents      Event[]

  // The composite unique is what lets Credentials relate on all three columns, so a username or
  // email change cannot leave the password row pointing at stale identity. Carried over from
  // projectNext unchanged.
  @@unique([id, username, email])
}

// Kept separate from User so a careless `select` on the user table cannot leak password hashes.
model Credentials {
  user                 User     @relation(fields: [userId, username, email], references: [id, username, email], onDelete: Cascade, onUpdate: Cascade)
  userId               Int      @unique
  username             String   @unique
  email                String   @unique
  passwordHash         String
  credentialsUpdatedAt DateTime @updatedAt

  @@unique([userId, username, email])
}

// Decision 2: database sessions rather than projectNext's JWT strategy.
//
// projectNext carries permissions and memberships inside the JWT, which is why
// src/auth/nextAuth/jwtCompression.ts exists at all - the pair overflows the 4096-byte cookie
// limit. Storing the session server-side removes that constraint, and means a permission change
// takes effect on the next request rather than at the next token refresh.
//
// SvelteKit makes this cheap: hooks.server.ts resolves the session once per request into
// event.locals, where projectNext resolves it inside every makeAction call.
model AuthSession {
  // A 256-bit random token, stored hashed. The raw value only ever lives in the cookie.
  tokenHash String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
