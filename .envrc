# direnv integration: entering this directory drops you into the dev shell.
#
#   nix profile install nixpkgs#direnv nixpkgs#nix-direnv   (once)
#   direnv allow                                            (here)
#
# `use flake` alone re-evaluates on every cd. nix-direnv caches the result and
# pins it against the GC, so the shell comes back instantly and does not get
# collected by `nix-collect-garbage`.
if ! has nix_direnv_version || ! nix_direnv_version 3.0.6; then
    source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" "sha256-RYcUJaRMf8oF5LznDrlCXbkOQrywm0HDv1VjYGaJGdM="
fi

use flake
