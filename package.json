{
    "name": "svele",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev --host 0.0.0.0",
        "build": "vite build",
        "preview": "vite preview",
        "start": "node build",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts",
        "test:phase0": "tsx tests/phase0.ts",
        "dev-seed": "prisma db push && tsx prisma/seed.ts && svelte-kit sync && vite dev --host 0.0.0.0",
        "prisma-studio": "prisma studio"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.3.0",
        "@prisma/client": "^7.3.0",
        "@sveltejs/kit": "^2.15.1",
        "lucide-svelte": "^1.0.1",
        "zod": "^3.24.1",
        "zod-form-data": "^2.0.4"
    },
    "devDependencies": {
        "@sveltejs/adapter-node": "^5.2.12",
        "@sveltejs/vite-plugin-svelte": "^5.0.3",
        "@tailwindcss/vite": "^4.3.3",
        "prisma": "^7.3.0",
        "svelte": "^5.16.0",
        "svelte-check": "^4.1.1",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.19.2",
        "typescript": "^5.9.3",
        "vite": "^6.0.7"
    }
}
